# Disable MultiViews to prevent Apache from doing implicit filename matching.
# On Apache (DreamHost), if /sports is requested and a file or folder named
# "sports" exists nearby, MultiViews can negotiate the match itself and
# bypass our SPA rewrite below, causing 404s or wrong-file responses. This
# is the same class of bug as a past incident where index.html got renamed
# to Index.html on the server and the SPA broke silently. Disabling
# MultiViews ensures the rewrite rule always wins.
Options -MultiViews +FollowSymLinks
RewriteEngine On
RewriteBase /

# Force HTTPS. Any request that came in over plain HTTP gets a permanent
# (301) redirect to the same path on HTTPS. %{HTTPS} reads "off" when the
# connection isn't TLS — the canonical Apache pattern. Paired with the
# Strict-Transport-Security header below, this means a returning visitor's
# browser won't even attempt HTTP after their first successful HTTPS visit.
# 301 is intentional: browsers cache it and search engines update indexed
# URLs. If you ever need to roll this back, change to 302 first so it's
# not cached forever.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# If the request is for an existing file (JS, CSS, JSON, images), serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# iCal subscription endpoint. /events.ics is a clean URL that calendar
# apps recognize by extension; the rewrite hands it to the PHP handler
# which filters by ?p= favorites and emits an iCal feed. QSA preserves
# the query string. The pretty URL also makes future implementation
# changes (PHP → static, etc.) transparent to subscribers.
RewriteRule ^events\.ics$ events.ics.php [L,QSA]

# For everything else, serve index.html (SPA routing)
RewriteRule ^ index.html [L]

# =====================================================================
# Cache-Control headers
# =====================================================================
# Different file types get different cache lifetimes:
#   - JSON data files: NO CACHE — scraper refreshes hourly, users always
#     see fresh data.
#   - HTML (index.html): NO CACHE — when we ship a code change, the next
#     visit needs to pick up the new app.js immediately. Caching HTML
#     even briefly delays deploy pickup with no real benefit (HTML is
#     tiny).
#   - CSS / JS: 5-minute cache — short enough that code deploys propagate
#     quickly, long enough to avoid hammering the server on every page
#     load. Our build doesn't hash filenames, so we can't safely cache
#     longer.
#   - Images, fonts, favicon: 1 year — these rarely change.
#
# IfModule guards keep the file safe if a module isn't loaded (it would just
# be ignored rather than throwing a 500). DreamHost has both modules enabled
# by default.

<IfModule mod_expires.c>
    ExpiresActive On

    # JSON data files — never cache, always fresh from server
    ExpiresByType application/json "access plus 0 seconds"

    # HTML — never cache (so code deploys pick up immediately on next visit)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS / JS — 5 minutes
    ExpiresByType text/css "access plus 5 minutes"
    ExpiresByType application/javascript "access plus 5 minutes"
    ExpiresByType text/javascript "access plus 5 minutes"

    # Images & icons — 1 year (rarely change)
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Fonts — 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Cache-Control + security headers. mod_headers is more reliably respected
# by modern caches/CDNs than mod_expires alone, so we set both. Security
# headers ship here too rather than in a separate block — same module guard.
<IfModule mod_headers.c>
    # Security headers — apply to all responses.
    # nosniff: prevents browsers from second-guessing the Content-Type
    #   header we send (a small XSS vector if we ever serve user content).
    # SAMEORIGIN: prevents other sites from iframing millersville.app for
    #   clickjacking. We iframe our own /mu-status-proxy.php from /emergency
    #   which is same-origin, so this doesn't break anything we do.
    # strict-origin-when-cross-origin: when a user clicks an outbound link,
    #   the destination only learns we're a millersville.app domain, not
    #   the specific page/path they were on. Privacy default.
    # HSTS: tells browsers to always use HTTPS for this domain (and
    #   subdomains) for the next 6 months. Paired with the HTTP->HTTPS
    #   rewrite above, this means a returning visitor's browser refuses
    #   to even attempt HTTP. CAUTION: this is "sticky" — if HTTPS ever
    #   breaks (cert expiry, renewal failure), users can't bypass the
    #   error. Let's Encrypt auto-renews on DreamHost so cert outages are
    #   rare, but if you ever need to roll back, change max-age to 0 and
    #   wait the 6 months for existing browsers to forget the policy.
    #   Starting at 6 months (15768000s); consider bumping to 1 year
    #   (31536000) or 2 years after a few weeks of confirmed stability.
    # Permissions-Policy: disables browser features we don't use. Empty
    #   parens () means "no origin including this one can use this feature."
    #   We deliberately leave notifications and service-worker stuff
    #   unmentioned — those are features we DO use for push notifications.
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=15768000; includeSubDomains"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=()"

    # JSON files & HTML: no caching at any layer. JSON for data freshness,
    # HTML so code deploys pick up instantly.
    <FilesMatch "\.(json|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # CSS/JS: short cache, allow revalidation. Our build doesn't hash
    # filenames so we can't safely go longer.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>

    # Images & fonts: long cache, immutable (won't change without a new URL)
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
